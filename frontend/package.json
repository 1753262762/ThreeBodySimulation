{
  "name": "three-body-lab-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run generate:contracts && vue-tsc -b && vitest run && vite build"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.5.2",
    "playwright-core": "^1.62.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
