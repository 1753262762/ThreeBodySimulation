{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://threebody.local/contracts/ws-events.schema.json",
  "title": "Three Body Lab WebSocket Envelope",
  "description": "WebSocket 地址为 /ws/v1/experiments/{id}。所有数值为 SI 单位。实时发布上限为快照 60 Hz、轨迹增量 60 Hz、指标 2 Hz（按单调墙钟截止时间，错过周期不补发）。envelope 的 sequence 在单个实验内单调递增，客户端必须丢弃不大于已处理值的消息；它只负责消息传输去重与顺序，不等于事件序列号。NEAR_ENCOUNTER 的 ENTER/FINAL 与 DIAGNOSTIC 走可靠 FIFO，NEAR_ENCOUNTER UPDATE 按 eventId 最新值合并，不占用可靠队列。1.1 版本 NEAR_ENCOUNTER 与 DIAGNOSTIC 的 payload 均为 { event: SimulationEvent }。",
  "type": "object",
  "required": ["schemaVersion", "type", "experimentId", "sequence", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "type": {
      "type": "string",
      "enum": ["SNAPSHOT", "TRAJECTORY", "METRICS", "STATUS", "NEAR_ENCOUNTER", "DIAGNOSTIC", "ERROR"]
    },
    "experimentId": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "SNAPSHOT" } } }, "then": { "properties": { "payload": { "$ref": "#/definitions/snapshotPayload" } } } },
    { "if": { "properties": { "type": { "const": "TRAJECTORY" } } }, "then": { "properties": { "payload": { "$ref": "#/definitions/trajectoryPayload" } } } },
    { "if": { "properties": { "type": { "const": "METRICS" } } }, "then": { "properties": { "payload": { "$ref": "#/definitions/metricsPayload" } } } },
    { "if": { "properties": { "type": { "const": "STATUS" } } }, "then": { "properties": { "payload": { "$ref": "#/definitions/statusPayload" } } } },
    { "if": { "properties": { "type": { "const": "NEAR_ENCOUNTER" } } }, "then": { "properties": { "payload": { "$ref": "#/definitions/eventPayload" } } } },
    { "if": { "properties": { "type": { "const": "DIAGNOSTIC" } } }, "then": { "properties": { "payload": { "$ref": "#/definitions/eventPayload" } } } },
    { "if": { "properties": { "type": { "const": "ERROR" } } }, "then": { "properties": { "payload": { "$ref": "#/definitions/errorPayload" } } } }
  ],
  "definitions": {
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "bodyState": {
      "type": "object",
      "required": ["id", "position", "velocity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "position": { "$ref": "#/definitions/vector3" },
        "velocity": { "$ref": "#/definitions/vector3" }
      }
    },
    "eventPhase": {
      "type": "string",
      "enum": ["ENTER", "UPDATE", "FINAL"]
    },
    "diagnosticSeverity": {
      "type": "string",
      "enum": ["NOTICE", "WARNING", "CRITICAL"]
    },
    "diagnosticCauseCategory": {
      "type": "string",
      "enum": ["PHYSICAL_PHENOMENON", "PARAMETER_RISK", "NUMERICAL_ERROR", "MIXED"]
    },
    "diagnosticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeStepSeconds": { "type": ["number", "null"] },
        "softeningLengthMeters": { "type": ["number", "null"] },
        "normalizedEnergyError": { "type": ["number", "null"] },
        "relativeEnergyDrift": { "type": ["number", "null"] },
        "minimumPairDistanceMeters": { "type": ["number", "null"] },
        "speedRatioToEscape": { "type": ["number", "null"] },
        "directionChangeDegrees": { "type": ["number", "null"] },
        "rmsRadiusRatio": { "type": ["number", "null"] },
        "outwardBodyFraction": { "type": ["number", "null"] },
        "lastStableStep": { "type": ["integer", "null"] },
        "bodyIds": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "causeCategory", "summary", "likelyCauses", "evidence", "recommendations"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": ["ENERGY_DRIFT", "POSSIBLE_ESCAPE", "SUDDEN_DEFLECTION", "RAPID_DISASSEMBLY", "NUMERICAL_INSTABILITY"]
        },
        "severity": { "$ref": "#/definitions/diagnosticSeverity" },
        "causeCategory": { "$ref": "#/definitions/diagnosticCauseCategory" },
        "summary": { "type": "string" },
        "likelyCauses": { "type": "array", "items": { "type": "string" } },
        "evidence": { "$ref": "#/definitions/diagnosticEvidence" },
        "recommendations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "simulationEvent": {
      "type": "object",
      "required": ["sequence", "type", "step", "simulationTimeSeconds", "timestamp", "message"],
      "additionalProperties": false,
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "description": "逻辑事件创建顺序，创建后不变" },
        "eventId": { "type": ["string", "null"] },
        "type": {
          "type": "string",
          "enum": ["NEAR_ENCOUNTER", "STATUS_CHANGE", "DIAGNOSTIC", "NUMERICAL_WARNING", "ERROR"]
        },
        "phase": { "anyOf": [{ "$ref": "#/definitions/eventPhase" }, { "type": "null" }] },
        "step": { "type": "integer", "minimum": 0 },
        "simulationTimeSeconds": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "message": { "type": "string" },
        "bodyIds": { "type": ["array", "null"], "items": { "type": "string" } },
        "distanceMeters": { "type": ["number", "null"] },
        "thresholdMeters": { "type": ["number", "null"] },
        "triggerDistanceMeters": { "type": ["number", "null"] },
        "closestDistanceMeters": { "type": ["number", "null"] },
        "closestStep": { "type": ["integer", "null"] },
        "closestSimulationTimeSeconds": { "type": ["number", "null"] },
        "midpointPosition": { "anyOf": [{ "$ref": "#/definitions/vector3" }, { "type": "null" }] },
        "diagnostic": { "anyOf": [{ "$ref": "#/definitions/diagnostic" }, { "type": "null" }] }
      }
    },
    "eventPayload": {
      "type": "object",
      "required": ["event"],
      "additionalProperties": false,
      "properties": {
        "event": { "$ref": "#/definitions/simulationEvent" }
      }
    },
    "snapshotPayload": {
      "type": "object",
      "required": ["step", "simulationTimeSeconds", "bodies"],
      "additionalProperties": false,
      "properties": {
        "step": { "type": "integer", "minimum": 0 },
        "simulationTimeSeconds": { "type": "number" },
        "bodies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": { "$ref": "#/definitions/bodyState" }
        }
      }
    },
    "trajectoryPayload": {
      "type": "object",
      "description": "自上一条 TRAJECTORY 消息以来新增的采样点，按 step 升序。",
      "required": ["fromStep", "toStep", "stride", "points"],
      "additionalProperties": false,
      "properties": {
        "fromStep": { "type": "integer", "minimum": 0 },
        "toStep": { "type": "integer", "minimum": 0 },
        "stride": { "type": "integer", "minimum": 1 },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "simulationTimeSeconds", "bodies"],
            "additionalProperties": false,
            "properties": {
              "step": { "type": "integer", "minimum": 0 },
              "simulationTimeSeconds": { "type": "number" },
              "bodies": {
                "type": "array",
                "items": { "$ref": "#/definitions/bodyState" }
              }
            }
          }
        }
      }
    },
    "metricsPayload": {
      "type": "object",
      "required": [
        "step",
        "simulationTimeSeconds",
        "kineticEnergyJoules",
        "potentialEnergyJoules",
        "totalEnergyJoules",
        "initialTotalEnergyJoules",
        "relativeEnergyDrift",
        "angularMomentum",
        "angularMomentumMagnitude",
        "linearMomentum",
        "linearMomentumMagnitude",
        "minimumPairDistanceMeters"
      ],
      "additionalProperties": false,
      "properties": {
        "step": { "type": "integer", "minimum": 0 },
        "simulationTimeSeconds": { "type": "number" },
        "kineticEnergyJoules": { "type": "number" },
        "potentialEnergyJoules": { "type": "number" },
        "totalEnergyJoules": { "type": "number" },
        "initialTotalEnergyJoules": { "type": "number" },
        "relativeEnergyDrift": { "type": "number" },
        "angularMomentum": { "$ref": "#/definitions/vector3" },
        "angularMomentumMagnitude": { "type": "number" },
        "linearMomentum": { "$ref": "#/definitions/vector3" },
        "linearMomentumMagnitude": { "type": "number" },
        "minimumPairDistanceMeters": { "type": "number" },
        "minimumPairBodyIds": { "type": ["array", "null"], "items": { "type": "string" } },
        "allTimeMinimumPairDistanceMeters": { "type": ["number", "null"] },
        "allTimeMinimumPairDistanceStep": { "type": ["integer", "null"] },
        "stepsPerSecond": { "type": ["number", "null"] },
        "elapsedWallClockSeconds": { "type": ["number", "null"] }
      }
    },
    "statusPayload": {
      "type": "object",
      "required": ["status", "step", "simulationTimeSeconds"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["QUEUED", "RUNNING", "PAUSED", "COMPLETED", "CANCELLED", "FAILED"]
        },
        "previousStatus": {
          "type": ["string", "null"],
          "enum": ["QUEUED", "RUNNING", "PAUSED", "COMPLETED", "CANCELLED", "FAILED", null]
        },
        "step": { "type": "integer", "minimum": 0 },
        "simulationTimeSeconds": { "type": "number" },
        "endReason": {
          "type": ["string", "null"],
          "enum": ["MAX_STEPS", "TARGET_TIME", "CANCELLED", "ERROR", null]
        },
        "completionRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "queuePosition": { "type": ["integer", "null"] },
        "message": { "type": ["string", "null"] }
      }
    },
    "errorPayload": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_FAILED",
            "EXPERIMENT_NOT_FOUND",
            "ILLEGAL_STATE_TRANSITION",
            "EXPERIMENT_NOT_EDITABLE",
            "QUEUE_CONFLICT",
            "UNSUPPORTED_ACTION_PAYLOAD",
            "MALFORMED_REQUEST",
            "STORAGE_FAILURE",
            "REPLAY_QUEUE_FULL",
            "REPLAY_JOB_NOT_FOUND",
            "NUMERICAL_INSTABILITY",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string" },
        "step": { "type": ["integer", "null"] },
        "recoverable": { "type": ["boolean", "null"] }
      }
    }
  }
}
